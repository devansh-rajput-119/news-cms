<h1 class="mb-4">Edit Article</h1>

<form method="POST" action="/articles/edit/<%= article._id %>">

    <div class="mb-3">
        <label>Title</label>
        <input
            type="text"
            name="title"
            class="form-control"
            value="<%= article.title %>"
            required>
    </div>

    <div class="mb-3">
        <label>Content</label>
        <textarea
            name="content"
            rows="8"
            class="form-control"
            required><%= article.content %></textarea>
    </div>

    <div class="mb-3">
        <label>Category</label>

        <select
            name="category"
            class="form-select">

            <% categories.forEach(category => { %>

                <option
                    value="<%= category._id %>"
                    <%= article.category &&
                        article.category._id.toString() === category._id.toString()
                        ? "selected"
                        : "" %>>
                    <%= category.name %>
                </option>

            <% }) %>

        </select>
    </div>

    <div class="mb-3">
        <label>Status</label>

        <select
            name="status"
            class="form-select">

            <option value="draft"
                <%= article.status === "draft" ? "selected" : "" %>>
                Draft
            </option>

            <option value="published"
                <%= article.status === "published" ? "selected" : "" %>>
                Published
            </option>

        </select>
    </div>

    <button class="btn btn-primary">
        Update Article
    </button>

</form>