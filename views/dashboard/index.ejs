<h1 class="mb-4">Dashboard</h1>

<div class="row">

    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Total Articles</h5>
                <h2><%= stats.totalArticles %></h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Published</h5>
                <h2><%= stats.publishedArticles %></h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Drafts</h5>
                <h2><%= stats.draftArticles %></h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body">
                <h5>Categories</h5>
                <h2><%= stats.totalCategories %></h2>
            </div>
        </div>
    </div>

    <hr>

<h3>Quick Actions</h3>

<div class="mt-3">

    <a href="/categories"
       class="btn btn-primary me-2">
       Manage Categories
    </a>

    <a href="/articles"
       class="btn btn-success">
       Manage Articles
    </a>

</div>

<hr class="my-4">

<h3>Recent Articles</h3>

<table class="table table-bordered mt-3">

    <thead>
        <tr>
            <th>Title</th>
            <th>Status</th>
            <th>Views</th>
        </tr>
    </thead>

<tbody>

    <% recentArticles.forEach(article => { %>

        <tr>

            <td>
                <%= article.title %>
            </td>

            <td>
                <%= article.status %>
            </td>

            <td>
                <%= article.views %>
            </td>

        </tr>

    <% }) %>

</tbody>

</table>

<hr class="my-4">

<h3>Top Viewed Articles</h3>

<table class="table table-bordered mt-3">

    <thead>
        <tr>
            <th>Title</th>
            <th>Views</th>
        </tr>
    </thead>

    <tbody>

        <% topViewedArticles.forEach(article => { %>

            <tr>

                <td>
                    <%= article.title %>
                </td>

                <td>
                    <%= article.views %>
                </td>

            </tr>

        <% }) %>

    </tbody>

</table>

<hr class="my-4">

<h3>Latest Categories</h3>

<table class="table table-bordered mt-3">

    <thead>
        <tr>
            <th>Category Name</th>
        </tr>
    </thead>

    <tbody>

        <% latestCategories.forEach(category => { %>

            <tr>

                <td>
                    <%= category.name %>
                </td>

            </tr>

        <% }) %>

    </tbody>

</table>

</div>